@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix math: <http://www.w3.org/2000/10/swap/math#>.

# ---------------------------------------------------------------------------
# oocert/checker.n3  --  N3/EYE re-implementation of OOCert.checkCert
# ---------------------------------------------------------------------------
# The data part of the input (generated by check.py) uses this vocabulary:
#   <urn:tr:K>   a canonical node for the unique triple (s,p,o)
#                <urn:s>/<urn:p>/<urn:o>  the three term strings (verbatim
#                                          N-Triples spelling)
#                a <urn:Asserted>         when the triple is in asserted.tsv
#   <urn:st:I>   a <urn:Step>; <urn:rule> <urn:rule:NAME>; <urn:idx> I
#                <urn:premise>   each premise triple node (unordered)
#                <urn:premiseList> ( ... )  the premises in documented order
#                <urn:conclusion> the conclusion triple node
# A step S is accepted iff we derive  <urn:st:I> <urn:ok> <urn:True>.

# ---------------------------------------------------------------------------
# meta-rules: which triples are KNOWN as premises of a step S
# ---------------------------------------------------------------------------
# A premise is known for S if it is asserted, or if an EARLIER step J that is
# itself ok concludes an identical (s,p,o).  The math:lessThan guard is what
# makes this the Lean semantics: only earlier-ok conclusions count, so the
# derivation is well founded and no circular certificate can pass.

{ ?P a <urn:Asserted> . ?S a <urn:Step> }
  => { ?P <urn:knownAt> ?S } .

{ ?J a <urn:Step> ; <urn:ok> <urn:True> ; <urn:idx> ?ji ; <urn:conclusion> ?C .
  ?C <urn:s> ?cs ; <urn:p> ?cp ; <urn:o> ?co .
  ?P <urn:s> ?cs ; <urn:p> ?cp ; <urn:o> ?co .
  ?S a <urn:Step> ; <urn:idx> ?si .
  ?ji math:lessThan ?si }
  => { ?P <urn:knownAt> ?S } .

# ---------------------------------------------------------------------------
# fixed-arity rules: premise order enforced by the <urn:premiseList> pattern
# ---------------------------------------------------------------------------

# rdfs2: [s p o ; p rdfs:domain c] => s rdf:type c
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:rdfs2> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2) .
  ?P1 <urn:s> ?s ; <urn:p> ?p ; <urn:o> ?o ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?p ; <urn:p> rdfs:domain ; <urn:o> ?c ; <urn:knownAt> ?S .
  ?C <urn:s> ?s ; <urn:p> rdf:type ; <urn:o> ?c }
  => { ?S <urn:ok> <urn:True> } .

# rdfs3: [s p o ; p rdfs:range c] => o rdf:type c
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:rdfs3> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2) .
  ?P1 <urn:s> ?s ; <urn:p> ?p ; <urn:o> ?o ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?p ; <urn:p> rdfs:range ; <urn:o> ?c ; <urn:knownAt> ?S .
  ?C <urn:s> ?o ; <urn:p> rdf:type ; <urn:o> ?c }
  => { ?S <urn:ok> <urn:True> } .

# rdfs5: [a sp b ; b sp c] => a sp c
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:rdfs5> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2) .
  ?P1 <urn:s> ?a ; <urn:p> rdfs:subPropertyOf ; <urn:o> ?b ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?b ; <urn:p> rdfs:subPropertyOf ; <urn:o> ?c ; <urn:knownAt> ?S .
  ?C <urn:s> ?a ; <urn:p> rdfs:subPropertyOf ; <urn:o> ?c }
  => { ?S <urn:ok> <urn:True> } .

# rdfs7: [s p o ; p sp q] => s q o
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:rdfs7> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2) .
  ?P1 <urn:s> ?s ; <urn:p> ?p ; <urn:o> ?o ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?p ; <urn:p> rdfs:subPropertyOf ; <urn:o> ?q ; <urn:knownAt> ?S .
  ?C <urn:s> ?s ; <urn:p> ?q ; <urn:o> ?o }
  => { ?S <urn:ok> <urn:True> } .

# rdfs9: [x rdf:type a ; a sc b] => x rdf:type b
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:rdfs9> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2) .
  ?P1 <urn:s> ?x ; <urn:p> rdf:type ; <urn:o> ?a ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?a ; <urn:p> rdfs:subClassOf ; <urn:o> ?b ; <urn:knownAt> ?S .
  ?C <urn:s> ?x ; <urn:p> rdf:type ; <urn:o> ?b }
  => { ?S <urn:ok> <urn:True> } .

# rdfs11: [a sc b ; b sc c] => a sc c
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:rdfs11> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2) .
  ?P1 <urn:s> ?a ; <urn:p> rdfs:subClassOf ; <urn:o> ?b ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?b ; <urn:p> rdfs:subClassOf ; <urn:o> ?c ; <urn:knownAt> ?S .
  ?C <urn:s> ?a ; <urn:p> rdfs:subClassOf ; <urn:o> ?c }
  => { ?S <urn:ok> <urn:True> } .

# prp-trp: [p rdf:type owl:TransitiveProperty ; x p y ; y p z] => x p z
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:prp-trp> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2 ?P3) .
  ?P1 <urn:s> ?p ; <urn:p> rdf:type ; <urn:o> owl:TransitiveProperty ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?x ; <urn:p> ?p ; <urn:o> ?y ; <urn:knownAt> ?S .
  ?P3 <urn:s> ?y ; <urn:p> ?p ; <urn:o> ?z ; <urn:knownAt> ?S .
  ?C <urn:s> ?x ; <urn:p> ?p ; <urn:o> ?z }
  => { ?S <urn:ok> <urn:True> } .

# prp-symp: [p rdf:type owl:SymmetricProperty ; x p y] => y p x
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:prp-symp> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2) .
  ?P1 <urn:s> ?p ; <urn:p> rdf:type ; <urn:o> owl:SymmetricProperty ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?x ; <urn:p> ?p ; <urn:o> ?y ; <urn:knownAt> ?S .
  ?C <urn:s> ?y ; <urn:p> ?p ; <urn:o> ?x }
  => { ?S <urn:ok> <urn:True> } .

# prp-inv1: [p owl:inverseOf q ; x p y] => y q x
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:prp-inv1> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2) .
  ?P1 <urn:s> ?p ; <urn:p> owl:inverseOf ; <urn:o> ?q ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?x ; <urn:p> ?p ; <urn:o> ?y ; <urn:knownAt> ?S .
  ?C <urn:s> ?y ; <urn:p> ?q ; <urn:o> ?x }
  => { ?S <urn:ok> <urn:True> } .

# prp-inv2: [p owl:inverseOf q ; x q y] => y p x
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:prp-inv2> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2) .
  ?P1 <urn:s> ?p ; <urn:p> owl:inverseOf ; <urn:o> ?q ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?x ; <urn:p> ?q ; <urn:o> ?y ; <urn:knownAt> ?S .
  ?C <urn:s> ?y ; <urn:p> ?p ; <urn:o> ?x }
  => { ?S <urn:ok> <urn:True> } .

# eq-sym: [a owl:sameAs b] => b owl:sameAs a
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:eq-sym> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1) .
  ?P1 <urn:s> ?a ; <urn:p> owl:sameAs ; <urn:o> ?b ; <urn:knownAt> ?S .
  ?C <urn:s> ?b ; <urn:p> owl:sameAs ; <urn:o> ?a }
  => { ?S <urn:ok> <urn:True> } .

# scm-eqc1 (both directions): [a owl:equivalentClass b] => a sc b OR b sc a
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:scm-eqc1> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1) .
  ?P1 <urn:s> ?a ; <urn:p> owl:equivalentClass ; <urn:o> ?b ; <urn:knownAt> ?S .
  ?C <urn:s> ?a ; <urn:p> rdfs:subClassOf ; <urn:o> ?b }
  => { ?S <urn:ok> <urn:True> } .
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:scm-eqc1> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1) .
  ?P1 <urn:s> ?a ; <urn:p> owl:equivalentClass ; <urn:o> ?b ; <urn:knownAt> ?S .
  ?C <urn:s> ?b ; <urn:p> rdfs:subClassOf ; <urn:o> ?a }
  => { ?S <urn:ok> <urn:True> } .

# scm-eqp1 (both directions): [a owl:equivalentProperty b] => a sp b OR b sp a
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:scm-eqp1> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1) .
  ?P1 <urn:s> ?a ; <urn:p> owl:equivalentProperty ; <urn:o> ?b ; <urn:knownAt> ?S .
  ?C <urn:s> ?a ; <urn:p> rdfs:subPropertyOf ; <urn:o> ?b }
  => { ?S <urn:ok> <urn:True> } .
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:scm-eqp1> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1) .
  ?P1 <urn:s> ?a ; <urn:p> owl:equivalentProperty ; <urn:o> ?b ; <urn:knownAt> ?S .
  ?C <urn:s> ?b ; <urn:p> rdfs:subPropertyOf ; <urn:o> ?a }
  => { ?S <urn:ok> <urn:True> } .

# cls-svf1: [r onProperty p ; r someValuesFrom c ; x p y ; y rdf:type c] => x rdf:type r
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:cls-svf1> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2 ?P3 ?P4) .
  ?P1 <urn:s> ?r ; <urn:p> owl:onProperty ; <urn:o> ?p ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?r ; <urn:p> owl:someValuesFrom ; <urn:o> ?c ; <urn:knownAt> ?S .
  ?P3 <urn:s> ?x ; <urn:p> ?p ; <urn:o> ?y ; <urn:knownAt> ?S .
  ?P4 <urn:s> ?y ; <urn:p> rdf:type ; <urn:o> ?c ; <urn:knownAt> ?S .
  ?C <urn:s> ?x ; <urn:p> rdf:type ; <urn:o> ?r }
  => { ?S <urn:ok> <urn:True> } .

# cls-avf: [r onProperty p ; r allValuesFrom c ; x rdf:type r ; x p y] => y rdf:type c
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:cls-avf> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2 ?P3 ?P4) .
  ?P1 <urn:s> ?r ; <urn:p> owl:onProperty ; <urn:o> ?p ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?r ; <urn:p> owl:allValuesFrom ; <urn:o> ?c ; <urn:knownAt> ?S .
  ?P3 <urn:s> ?x ; <urn:p> rdf:type ; <urn:o> ?r ; <urn:knownAt> ?S .
  ?P4 <urn:s> ?x ; <urn:p> ?p ; <urn:o> ?y ; <urn:knownAt> ?S .
  ?C <urn:s> ?y ; <urn:p> rdf:type ; <urn:o> ?c }
  => { ?S <urn:ok> <urn:True> } .

# cls-hv1: [r onProperty p ; r hasValue v ; x rdf:type r] => x p v
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:cls-hv1> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2 ?P3) .
  ?P1 <urn:s> ?r ; <urn:p> owl:onProperty ; <urn:o> ?p ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?r ; <urn:p> owl:hasValue ; <urn:o> ?v ; <urn:knownAt> ?S .
  ?P3 <urn:s> ?x ; <urn:p> rdf:type ; <urn:o> ?r ; <urn:knownAt> ?S .
  ?C <urn:s> ?x ; <urn:p> ?p ; <urn:o> ?v }
  => { ?S <urn:ok> <urn:True> } .

# cls-hv2: [r onProperty p ; r hasValue v ; x p v] => x rdf:type r
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:cls-hv2> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2 ?P3) .
  ?P1 <urn:s> ?r ; <urn:p> owl:onProperty ; <urn:o> ?p ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?r ; <urn:p> owl:hasValue ; <urn:o> ?v ; <urn:knownAt> ?S .
  ?P3 <urn:s> ?x ; <urn:p> ?p ; <urn:o> ?v ; <urn:knownAt> ?S .
  ?C <urn:s> ?x ; <urn:p> rdf:type ; <urn:o> ?r }
  => { ?S <urn:ok> <urn:True> } .

# scm-svf1: [c1 svf y1 ; c1 onProperty p ; c2 svf y2 ; c2 onProperty p ; y1 sc y2] => c1 sc c2
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:scm-svf1> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2 ?P3 ?P4 ?P5) .
  ?P1 <urn:s> ?c1 ; <urn:p> owl:someValuesFrom ; <urn:o> ?y1 ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?c1 ; <urn:p> owl:onProperty ; <urn:o> ?p ; <urn:knownAt> ?S .
  ?P3 <urn:s> ?c2 ; <urn:p> owl:someValuesFrom ; <urn:o> ?y2 ; <urn:knownAt> ?S .
  ?P4 <urn:s> ?c2 ; <urn:p> owl:onProperty ; <urn:o> ?p ; <urn:knownAt> ?S .
  ?P5 <urn:s> ?y1 ; <urn:p> rdfs:subClassOf ; <urn:o> ?y2 ; <urn:knownAt> ?S .
  ?C <urn:s> ?c1 ; <urn:p> rdfs:subClassOf ; <urn:o> ?c2 }
  => { ?S <urn:ok> <urn:True> } .

# scm-svf2: [c1 svf y ; c1 onProperty p1 ; c2 svf y ; c2 onProperty p2 ; p1 sp p2] => c1 sc c2
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:scm-svf2> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2 ?P3 ?P4 ?P5) .
  ?P1 <urn:s> ?c1 ; <urn:p> owl:someValuesFrom ; <urn:o> ?y ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?c1 ; <urn:p> owl:onProperty ; <urn:o> ?p1 ; <urn:knownAt> ?S .
  ?P3 <urn:s> ?c2 ; <urn:p> owl:someValuesFrom ; <urn:o> ?y ; <urn:knownAt> ?S .
  ?P4 <urn:s> ?c2 ; <urn:p> owl:onProperty ; <urn:o> ?p2 ; <urn:knownAt> ?S .
  ?P5 <urn:s> ?p1 ; <urn:p> rdfs:subPropertyOf ; <urn:o> ?p2 ; <urn:knownAt> ?S .
  ?C <urn:s> ?c1 ; <urn:p> rdfs:subClassOf ; <urn:o> ?c2 }
  => { ?S <urn:ok> <urn:True> } .

# scm-avf1: [c1 avf y1 ; c1 onProperty p ; c2 avf y2 ; c2 onProperty p ; y1 sc y2] => c1 sc c2
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:scm-avf1> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2 ?P3 ?P4 ?P5) .
  ?P1 <urn:s> ?c1 ; <urn:p> owl:allValuesFrom ; <urn:o> ?y1 ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?c1 ; <urn:p> owl:onProperty ; <urn:o> ?p ; <urn:knownAt> ?S .
  ?P3 <urn:s> ?c2 ; <urn:p> owl:allValuesFrom ; <urn:o> ?y2 ; <urn:knownAt> ?S .
  ?P4 <urn:s> ?c2 ; <urn:p> owl:onProperty ; <urn:o> ?p ; <urn:knownAt> ?S .
  ?P5 <urn:s> ?y1 ; <urn:p> rdfs:subClassOf ; <urn:o> ?y2 ; <urn:knownAt> ?S .
  ?C <urn:s> ?c1 ; <urn:p> rdfs:subClassOf ; <urn:o> ?c2 }
  => { ?S <urn:ok> <urn:True> } .

# scm-avf2: [c1 avf y ; c1 onProperty p1 ; c2 avf y ; c2 onProperty p2 ; p1 sp p2] => c2 sc c1
#   NOTE the conclusion is REVERSED (W3C table, universal restriction is antitone).
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:scm-avf2> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2 ?P3 ?P4 ?P5) .
  ?P1 <urn:s> ?c1 ; <urn:p> owl:allValuesFrom ; <urn:o> ?y ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?c1 ; <urn:p> owl:onProperty ; <urn:o> ?p1 ; <urn:knownAt> ?S .
  ?P3 <urn:s> ?c2 ; <urn:p> owl:allValuesFrom ; <urn:o> ?y ; <urn:knownAt> ?S .
  ?P4 <urn:s> ?c2 ; <urn:p> owl:onProperty ; <urn:o> ?p2 ; <urn:knownAt> ?S .
  ?P5 <urn:s> ?p1 ; <urn:p> rdfs:subPropertyOf ; <urn:o> ?p2 ; <urn:knownAt> ?S .
  ?C <urn:s> ?c2 ; <urn:p> rdfs:subClassOf ; <urn:o> ?c1 }
  => { ?S <urn:ok> <urn:True> } .

# scm-dom1: [p rdfs:domain c1 ; c1 sc c2] => p rdfs:domain c2
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:scm-dom1> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2) .
  ?P1 <urn:s> ?p ; <urn:p> rdfs:domain ; <urn:o> ?c1 ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?c1 ; <urn:p> rdfs:subClassOf ; <urn:o> ?c2 ; <urn:knownAt> ?S .
  ?C <urn:s> ?p ; <urn:p> rdfs:domain ; <urn:o> ?c2 }
  => { ?S <urn:ok> <urn:True> } .

# scm-dom2: [p2 rdfs:domain c ; p1 sp p2] => p1 rdfs:domain c
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:scm-dom2> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2) .
  ?P1 <urn:s> ?p2 ; <urn:p> rdfs:domain ; <urn:o> ?c ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?p1 ; <urn:p> rdfs:subPropertyOf ; <urn:o> ?p2 ; <urn:knownAt> ?S .
  ?C <urn:s> ?p1 ; <urn:p> rdfs:domain ; <urn:o> ?c }
  => { ?S <urn:ok> <urn:True> } .

# scm-rng1: [p rdfs:range c1 ; c1 sc c2] => p rdfs:range c2
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:scm-rng1> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2) .
  ?P1 <urn:s> ?p ; <urn:p> rdfs:range ; <urn:o> ?c1 ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?c1 ; <urn:p> rdfs:subClassOf ; <urn:o> ?c2 ; <urn:knownAt> ?S .
  ?C <urn:s> ?p ; <urn:p> rdfs:range ; <urn:o> ?c2 }
  => { ?S <urn:ok> <urn:True> } .

# scm-rng2: [p2 rdfs:range c ; p1 sp p2] => p1 rdfs:range c
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:scm-rng2> ; <urn:conclusion> ?C ; <urn:premiseList> (?P1 ?P2) .
  ?P1 <urn:s> ?p2 ; <urn:p> rdfs:range ; <urn:o> ?c ; <urn:knownAt> ?S .
  ?P2 <urn:s> ?p1 ; <urn:p> rdfs:subPropertyOf ; <urn:o> ?p2 ; <urn:knownAt> ?S .
  ?C <urn:s> ?p1 ; <urn:p> rdfs:range ; <urn:o> ?c }
  => { ?S <urn:ok> <urn:True> } .

# ---------------------------------------------------------------------------
# list rules: cls-int1, cls-int2, cls-uni, cls-oo
# ---------------------------------------------------------------------------
# These read an RDF list.  The list chain is emitted in the data as REAL
# asserted triples (<l> rdf:first <m> . <l> rdf:rest <l2> .) but ONLY for
# chain triples that appear in asserted.tsv, so membership is read off the
# asserted graph exactly as Rules.lean's `inG` reads it.  DOCUMENTED
# RELAXATION: the exact positional interleaving of the chain triples inside
# the step's premise list is NOT enforced (membership is read from the asserted
# chain), but the constructor must be one of the step's premises and asserted,
# and the typed-member premises must be premises of the step and known.

{ ?L rdf:first ?M } => { ?L <urn:member> ?M } .
{ ?L rdf:rest ?L2 . ?L2 <urn:member> ?M } => { ?L <urn:member> ?M } .

# A premise of S types the conclusion's subject with member ?M.
{ ?S <urn:conclusion> ?C . ?C <urn:s> ?X .
  ?S <urn:premise> ?P .
  ?P <urn:s> ?X ; <urn:p> rdf:type ; <urn:o> ?M ; <urn:knownAt> ?S }
  => { ?S <urn:memberTyped> ?M } .

# allTyped(L): every member of L is typed for S (recursive over the asserted chain).
{ ?S a <urn:Step> } => { ?S <urn:allTyped> rdf:nil } .
{ ?L rdf:rest ?L2 . ?L rdf:first ?M .
  ?S <urn:allTyped> ?L2 . ?S <urn:memberTyped> ?M }
  => { ?S <urn:allTyped> ?L } .

# cls-int1: [c owl:intersectionOf l ; chain ; x rdf:type m for EVERY member m] => x rdf:type c
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:cls-int1> ; <urn:conclusion> ?C ; <urn:premise> ?Cons .
  ?C <urn:s> ?x ; <urn:p> rdf:type ; <urn:o> ?c .
  ?Cons <urn:s> ?c ; <urn:p> owl:intersectionOf ; <urn:o> ?l ; a <urn:Asserted> .
  ?S <urn:allTyped> ?l }
  => { ?S <urn:ok> <urn:True> } .

# cls-int2: [c owl:intersectionOf l ; chain ; x rdf:type c] => x rdf:type m for one member m
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:cls-int2> ; <urn:conclusion> ?C ; <urn:premise> ?Cons .
  ?C <urn:s> ?x ; <urn:p> rdf:type ; <urn:o> ?m .
  ?Cons <urn:s> ?c ; <urn:p> owl:intersectionOf ; <urn:o> ?l ; a <urn:Asserted> .
  ?l <urn:member> ?m .
  ?S <urn:premise> ?P . ?P <urn:s> ?x ; <urn:p> rdf:type ; <urn:o> ?c ; <urn:knownAt> ?S }
  => { ?S <urn:ok> <urn:True> } .

# cls-uni: [c owl:unionOf l ; chain ; x rdf:type m for one member m] => x rdf:type c
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:cls-uni> ; <urn:conclusion> ?C ; <urn:premise> ?Cons .
  ?C <urn:s> ?x ; <urn:p> rdf:type ; <urn:o> ?c .
  ?Cons <urn:s> ?c ; <urn:p> owl:unionOf ; <urn:o> ?l ; a <urn:Asserted> .
  ?l <urn:member> ?m .
  ?S <urn:premise> ?P . ?P <urn:s> ?x ; <urn:p> rdf:type ; <urn:o> ?m ; <urn:knownAt> ?S }
  => { ?S <urn:ok> <urn:True> } .

# cls-oo: [c owl:oneOf l ; chain] => m rdf:type c for one member m
{ ?S a <urn:Step> ; <urn:rule> <urn:rule:cls-oo> ; <urn:conclusion> ?C ; <urn:premise> ?Cons .
  ?C <urn:s> ?m ; <urn:p> rdf:type ; <urn:o> ?c .
  ?Cons <urn:s> ?c ; <urn:p> owl:oneOf ; <urn:o> ?l ; a <urn:Asserted> .
  ?l <urn:member> ?m }
  => { ?S <urn:ok> <urn:True> } .
